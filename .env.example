# 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# Vercel 에는 Project → Settings → Environment Variables 에 같은 이름으로 등록하세요.

# 배포 주소 (OG 이미지·카카오 공유 링크의 절대 경로에 사용). 끝에 / 없이.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# 카카오 developers → 내 애플리케이션 → 앱 키 → JavaScript 키
# 카카오톡 공유 + 카카오맵 지도 표시에 같이 사용합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 오픈 전 비공개 모드 ──
# true 로 바꾸면 모든 방문자에게 청첩장이 공개됩니다. (그 전에는 안내 페이지가 보임)
SITE_OPEN=false
# 이 값으로 https://주소/?preview=<값> 에 한 번 접속하면 그 브라우저에서는 청첩장이 보입니다.
# 추측하기 어려운 긴 문자열로 정하세요. (NEXT_PUBLIC_ 을 붙이지 마세요)
PREVIEW_SECRET=
